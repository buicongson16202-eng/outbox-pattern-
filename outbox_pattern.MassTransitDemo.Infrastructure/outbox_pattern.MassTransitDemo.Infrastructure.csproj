<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tầng ngoài: cài đặt các cổng của Application bằng EF Core (SQL Server) và MassTransit (outbox/inbox, transport). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- MassTransit 8.x: giấy phép Apache-2.0. Từ v9 MassTransit là sản phẩm thương mại (Massient) và cần license key -
         xem docs/masstransit.md mục 1.3 trước khi nâng phiên bản. -->
    <PackageReference Include="MassTransit" Version="8.5.11" />
    <PackageReference Include="MassTransit.EntityFrameworkCore" Version="8.5.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <!-- Ghim bản vá cho package gián tiếp do Microsoft.Data.SqlClient kéo vào (giống project outbox_pattern). Bỏ dòng này khi SqlClient tự nâng. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\outbox_pattern.MassTransitDemo.Application\outbox_pattern.MassTransitDemo.Application.csproj" />
  </ItemGroup>

</Project>
