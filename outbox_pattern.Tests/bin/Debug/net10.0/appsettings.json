{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Server=(localdb)\\MSSQLLocalDB;Database=OutboxPatternDemo;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Outbox": {
    "PollingInterval": "00:00:01",
    "BatchSize": 20,
    "PublishTimeout": "00:00:10",
    "MaxBackoff": "00:01:00",
    "CleanupInterval": "00:10:00",
    "OutboxRetention": "7.00:00:00",
    "InboxRetention": "14.00:00:00"
  }
}
